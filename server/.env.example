NODE_ENV=development
PORT=4000
# Public URL of the shop (used for canonical URLs, sitemap, Open Graph)
SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# AlwaysData PostgreSQL - URL-encode special characters in the password (@ -> %40)
DATABASE_URL=postgres://USER:PASSWORD@postgresql-ACCOUNT.alwaysdata.net:5432/DATABASE
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin account, created by `npm run db:seed` (change the password after first login)
ADMIN_EMAIL=admin@sopureskin.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# Cloudflare R2 - leave empty in development to store images in server/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL (r2.dev subdomain or custom domain such as https://cdn.sopureskin.com)
R2_PUBLIC_URL=

# Groq (assistant Soso) - free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically when the free-tier minute quota of the main model is reached
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
