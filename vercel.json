{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "services": {
    "web": {
      "root": "client/",
      "framework": "vite",
      "installCommand": "cd .. && npm install --workspace=client --workspace=server --include=dev",
      "buildCommand": "npm run build && node ../server/scripts/prerender.mjs",
      "outputDirectory": "dist",
      "trailingSlash": false,
      "rewrites": [
        { "source": "/:lang(fr|en|ar)", "destination": "/:lang.html" },
        { "source": "/:lang(fr|en|ar)/guides", "destination": "/:lang/guides.html" },
        { "source": "/(.*)", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/:lang(fr|en|ar)/:path*",
          "headers": [{ "key": "Content-Type", "value": "text/html; charset=utf-8" }]
        },
        {
          "source": "/assets/(.*)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/hero/(.*)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
        }
      ]
    },
    "api": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "src/app.js",
      "installCommand": "cd .. && npm install --workspace=server --include=dev",
      "buildCommand": "npm run db:migrate",
      "bindings": [{ "type": "service", "service": "web", "format": "url", "env": "WEB_URL" }]
    }
  },
  "redirects": [{ "source": "/", "destination": "/fr", "permanent": true }],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
