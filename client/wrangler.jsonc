// Cloudflare Workers deployment of the storefront (see worker/index.js and README "Cloudflare Workers").
// Build + deploy: npm run deploy:cf -w client
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sopureskin-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /admin/* and unknown paths get index.html (the React router takes over)
    "not_found_handling": "single-page-application",
    // Hashed bundles and hero images are served straight from the edge, without running the Worker
    "run_worker_first": ["/*", "!/assets/*", "!/hero/*", "!/brand/*"]
  },
  "vars": {
    // Where the Express API runs (the existing Vercel project URL, NOT www.sopureskin.com)
    "API_ORIGIN": "https://YOUR-VERCEL-PROJECT.vercel.app"
  },
  // PROXY_SECRET is a secret: npx wrangler secret put PROXY_SECRET (same value as PROXY_SECRET on the API)
  "observability": { "enabled": true }
  // Custom domain, once the DNS of sopureskin.com is on Cloudflare:
  // "routes": [{ "pattern": "www.sopureskin.com", "custom_domain": true }]
}
