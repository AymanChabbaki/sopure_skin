// So Pure Skin on Cloudflare Workers.
// - Shop pages are pre-rendered static files (server/scripts/prerender.mjs) served from the edge: no Worker run, no CPU.
// - Only /api/* runs the Worker (Express, server/src/worker.js), with public GET responses cached at the edge.
// Deploy from this PC: npm run deploy   — or connect the GitHub repo in Workers Builds (see README / chat notes).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sopureskin",
	"main": "server/src/worker.js",
	"compatibility_date": "2026-10-01",
	// Node.js APIs for Express, pg, jsonwebtoken…; process.env is filled from vars and secrets
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./client/dist",
		"binding": "ASSETS",
		// /fr/shop -> fr/shop.html (pre-rendered pages)
		"html_handling": "auto-trailing-slash",
		// /admin/* and pages created after the last build get index.html (the React router takes over)
		"not_found_handling": "single-page-application",
		// Everything else never wakes the Worker (static requests are free and unlimited)
		"run_worker_first": ["/api/*"]
	},
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "sopureskin" }],
	// Pools the connections to AlwaysData. Create it once in the new account, then paste the id below:
	//   npx wrangler hyperdrive create sopureskin-db --connection-string="<DATABASE_URL from server/.env>"
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "9fefe78921064f5099269e989dad4213" }],
	"vars": {
		"NODE_ENV": "production",
		"SITE_URL": "https://www.sopureskin.com",
		"R2_BUCKET": "sopureskin",
		"R2_PUBLIC_URL": "https://images.sopureskin.com",
		"GROQ_MODEL": "openai/gpt-oss-120b",
		"GROQ_FALLBACK_MODELS": "openai/gpt-oss-20b"
	},
	// Secrets (never in this file): npm run cf:secrets  (copies them from server/.env)
	"alias": {
		"sharp": "./server/src/lib/stubs/sharp.js",
		"@aws-sdk/client-s3": "./server/src/lib/stubs/aws-s3.js",
		"nodemailer": "./server/src/lib/stubs/nodemailer.js"
	},
	"observability": { "enabled": true },
	"workers_dev": true,
	// The bare domain is served by server/apex-redirect (301 to www)
	"routes": [
		{ "pattern": "www.sopureskin.com", "custom_domain": true }
	]
}
