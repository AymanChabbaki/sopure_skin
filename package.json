{
  "name": "sopure-skin",
  "private": true,
  "version": "1.0.0",
  "description": "So Pure Skin - boutique K-beauty e-commerce (React + Express + PostgreSQL + Cloudflare R2)",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:logos": "npm run db:logos -w server",
    "db:sample-reviews": "npm run db:sample-reviews -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
